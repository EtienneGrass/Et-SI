  "grille_analyse_temporelle": {
    "horizon_1_an": {
      "label": "Court terme",
      "description": "Effets mécaniques et réactions immédiates",
      "hypotheses": [
        "Les prix s'ajustent rapidement",
        "Les comportements changent à la marge (élasticités court terme)",
        "Pas de restructuration de l'offre",
        "Effets budgétaires directs sur les finances publiques",
        "Les capacités de production sont fixes"
      ]
    },
    "horizon_3_ans": {
      "label": "Moyen terme",
      "description": "Adaptations comportementales et ajustements structurels",
      "hypotheses": [
        "Les agents ajustent durablement leurs comportements",
        "L'offre commence à s'adapter (investissements, entrées/sorties)",
        "Les effets de second tour se manifestent",
        "Les filières se restructurent partiellement",
        "Les infrastructures existantes sont mieux utilisées"
      ]
    },
    "horizon_10_ans": {
      "label": "Long terme",
      "description": "Transformation structurelle et nouvel équilibre",
      "hypotheses": [
        "Transformation profonde des comportements",
        "Restructuration complète de l'offre",
        "Nouvelles infrastructures possibles",
        "Effets intergénérationnels",
        "Innovation et disruption technologique possibles",
        "Contexte macroéconomique susceptible d'évoluer significativement"
      ]
    }
  },

  "grille_impact_macro": {
    "dimensions": [
      {
        "id": "pib",
        "label": "Croissance / PIB",
        "indicateurs": ["Variation PIB (Md€)", "Impact taux de croissance (points)"],
        "methode": "Multiplicateur keynésien + effets d'offre long terme"
      },
      {
        "id": "emploi",
        "label": "Emploi",
        "indicateurs": ["Créations/destructions nettes (ETP)", "Impact taux de chômage (points)"],
        "methode": "Contenu en emploi sectoriel + élasticité coût du travail"
      },
      {
        "id": "finances_publiques",
        "label": "Finances publiques",
        "indicateurs": ["Impact recettes (M€)", "Impact dépenses (M€)", "Solde net (M€)"],
        "methode": "Effet direct + retour fiscal (TVA, cotisations, IR)"
      },
      {
        "id": "inflation",
        "label": "Prix / Inflation",
        "indicateurs": ["Impact IPC (points)", "Secteurs les plus touchés"],
        "methode": "Pass-through des coûts + effets concurrentiels"
      },
      {
        "id": "environnement",
        "label": "Environnement",
        "indicateurs": ["Variation émissions GES (MtCO₂e/an)", "Autres impacts environnementaux"],
        "methode": "Facteurs d'émission + variation d'activité"
      },
      {
        "id": "sante",
        "label": "Santé publique",
        "indicateurs": ["Décès évités/an", "DALY économisés", "Économies Assurance maladie (M€)"],
        "methode": "Études épidémiologiques + fractions attribuables"
      },
      {
        "id": "inegalites",
        "label": "Inégalités / Cohésion sociale",
        "indicateurs": ["Variation Gini (points)", "Impact ratio interdécile D9/D1", "Acceptabilité sociale"],
        "methode": "Microsimulation par décile + analyse qualitative"
      },
      {
        "id": "commerce_exterieur",
        "label": "Commerce extérieur",
        "indicateurs": ["Impact balance commerciale (M€)", "Compétitivité-prix"],
        "methode": "Variation importations/exportations sectorielles"
      }
    ]
  },

  "methodes_estimation": {
    "effet_mecanique": {
      "description": "Calcul arithmétique direct sans changement de comportement",
      "exemple": "Si taxe de 15€ sur billet d'avion × 25M passagers = 375 M€ de recettes brutes"
    },
    "effet_comportemental": {
      "description": "Application d'élasticités pour tenir compte des réactions des agents",
      "exemple": "Hausse de 18% du prix de l'avion × élasticité -1.0 → baisse de 18% de la demande"
    },
    "effet_second_tour": {
      "description": "Réactions en chaîne (ajustement de l'offre, effets sur l'emploi, retour fiscal)",
      "exemple": "Baisse demande avion → restructuration compagnies → perte d'emplois → moindre consommation"
    },
    "effet_structurel": {
      "description": "Transformation profonde des marchés, des filières ou des normes sociales",
      "exemple": "Report modal massif → investissement ferroviaire → nouvelle géographie des mobilités"
    }
  },

  "niveaux_confiance": {
    "solide": {
      "emoji": "🟢",
      "label": "Solide",
      "description": "Fondé sur des données empiriques directes et des études robustes",
      "exemples": ["Données INSEE/DREES", "Méta-analyses", "Évaluations ex post de réformes similaires"]
    },
    "raisonnable": {
      "emoji": "🟡",
      "label": "Raisonnable",
      "description": "Extrapolation fondée sur des données indirectes ou des analogies solides",
      "exemples": ["Élasticités estimées dans des contextes comparables", "Modélisations calibrées", "Consensus d'experts"]
    },
    "exploratoire": {
      "emoji": "🔴",
      "label": "Exploratoire",
      "description": "Estimation à dire d'expert, incertitude forte",
      "exemples": ["Réformes sans précédent", "Effets de long terme", "Changements comportementaux profonds"]
    }
  }
}
